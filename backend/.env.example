# Local PostgreSQL with pgvector. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://apnasathi:change-me@localhost:5432/apnasathi
DB_SSL=false
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# For AWS ECS, omit DATABASE_URL and use the injected RDS settings instead:
# DB_HOST=<private-rds-endpoint>
# DB_PORT=5432
# DB_NAME=apnasathi
# DATABASE_CREDENTIALS=<Secrets Manager JSON injected by ECS>

# Google OAuth Web client ID (audience expected by the backend)
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Local multilingual semantic retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-base
FASTEMBED_CACHE_PATH=./.cache/fastembed
ANSWER_CACHE_SIMILARITY_THRESHOLD=0.88
ENABLE_SHARED_KNOWLEDGE=false
