# Local ADC. Run gcloud auth application-default login first.
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
# Audio storage. Use your AWS CLI profile locally and the task role in ECS.
AUDIO_S3_BUCKET=YOUR_PRIVATE_AUDIO_BUCKET
AWS_REGION=ap-south-1
AWS_PROFILE=apnasathi
# ECS injects GOOGLE_WIF_CONFIG_JSON from Secrets Manager.
